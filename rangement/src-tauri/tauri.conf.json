{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rayan’s Rangement",
  "mainBinaryName": "Rayans Rangement",
  "version": "1.1.0",
  "identifier": "fr.rayan.rangement",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rayan’s Rangement",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Rangement des Téléchargements et du Bureau",
    "longDescription": "Rayan’s Rangement range vos fichiers selon vos règles, avec un aperçu avant chaque rangement, sans jamais rien supprimer ni écraser, et un historique pour tout annuler.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
