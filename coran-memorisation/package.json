{
  "name": "rayans-hifz",
  "productName": "Rayans Hifz",
  "version": "1.0.0",
  "description": "Rayan's Hifz : suivi de mémorisation du Coran (progression, révisions espacées, mode révision, audio)",
  "main": "src/main/main.cjs",
  "type": "module",
  "license": "MIT",
  "author": "Rayan's Apps",
  "private": true,
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "build:meta": "node scripts/build-meta.cjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:ui && electron .",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/unit/*.test.ts",
    "test:lancement": "node scripts/test-lancement.js",
    "dist:win": "npm run build:ui && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2"
  },
  "build": {
    "appId": "fr.rayans-apps.hifz",
    "productName": "Rayans Hifz",
    "copyright": "Code sous licence MIT ; texte et traduction : Tanzil Project (voir LICENCES)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "dist-ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "quran-uthmani.txt",
          "fr.hamidullah.txt"
        ]
      },
      {
        "from": "fonts/OFL.txt",
        "to": "licences/OFL-Amiri.txt"
      }
    ],
    "extraFiles": [
      {
        "from": "LICENCES",
        "to": "LICENCES.txt"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Rayans-Hifz-${version}-Windows-x64.${ext}"
    }
  }
}
