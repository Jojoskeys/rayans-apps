<settings>
    <setting propertyKey="@Properties.tractionsObjectif" title="@Strings.tractionsObjectif">
        <settingConfig type="numeric" min="0" max="100"/>
    </setting>
    <setting propertyKey="@Properties.tractionsRappel" title="@Strings.tractionsRappel">
        <settingConfig type="numeric" min="0" max="600"/>
    </setting>
    <setting propertyKey="@Properties.pompesObjectif" title="@Strings.pompesObjectif">
        <settingConfig type="numeric" min="0" max="100"/>
    </setting>
    <setting propertyKey="@Properties.pompesRappel" title="@Strings.pompesRappel">
        <settingConfig type="numeric" min="0" max="600"/>
    </setting>
    <setting propertyKey="@Properties.sensibilite" title="@Strings.sensibilite">
        <settingConfig type="list">
            <listEntry value="0">@Strings.sensBasse</listEntry>
            <listEntry value="1">@Strings.sensNormale</listEntry>
            <listEntry value="2">@Strings.sensHaute</listEntry>
        </settingConfig>
    </setting>
</settings>
