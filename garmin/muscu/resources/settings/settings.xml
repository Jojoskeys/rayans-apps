<settings>
    <setting propertyKey="@Properties.tractionsSeries" title="@Strings.tractionsSeries">
        <settingConfig type="numeric" min="1" max="10"/>
    </setting>
    <setting propertyKey="@Properties.tractionsReps" title="@Strings.tractionsReps">
        <settingConfig type="numeric" min="1" max="50"/>
    </setting>
    <setting propertyKey="@Properties.tractionsRepos" title="@Strings.tractionsRepos">
        <settingConfig type="numeric" min="15" max="600"/>
    </setting>
    <setting propertyKey="@Properties.pompesSeries" title="@Strings.pompesSeries">
        <settingConfig type="numeric" min="1" max="10"/>
    </setting>
    <setting propertyKey="@Properties.pompesReps" title="@Strings.pompesReps">
        <settingConfig type="numeric" min="1" max="100"/>
    </setting>
    <setting propertyKey="@Properties.pompesRepos" title="@Strings.pompesRepos">
        <settingConfig type="numeric" min="15" max="600"/>
    </setting>
    <setting propertyKey="@Properties.sensibilite" title="@Strings.sensibilite">
        <settingConfig type="list">
            <listEntry value="0">@Strings.sensBasse</listEntry>
            <listEntry value="1">@Strings.sensNormale</listEntry>
            <listEntry value="2">@Strings.sensHaute</listEntry>
        </settingConfig>
    </setting>
</settings>
