{
  "name": "rayans-revision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rayan's Révision : cartes de révision et quiz avec répétition espacée (FSRS), application de bureau Windows (Tauri + React + TypeScript)",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "build:windows": "tauri build --no-bundle",
    "tauri": "tauri",
    "test": "tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.8",
    "vitest": "3.2.4"
  }
}
