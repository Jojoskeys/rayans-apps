{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rayans Revision",
  "mainBinaryName": "Rayans Revision",
  "version": "1.0.0",
  "identifier": "fr.rayan.revision",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rayan’s Révision",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600,
        "backgroundColor": "#0F1117"
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Cartes de révision et quiz",
    "longDescription": "Rayan’s Révision : cartes de révision, QCM et textes à trous avec répétition espacée (FSRS)."
  }
}
